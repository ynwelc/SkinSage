from pydantic_settings import BaseSettings
from typing import Optional

class Settings(BaseSettings):
    """应用配置类"""

    # 基本配置
    APP_NAME: str = "SkinSage - 智能美容咨询助手"
    APP_VERSION: str = "1.0.0"
    DEBUG: bool = True

    # 数据库配置（从环境变量读取）
    DATABASE_URL: str = "mysql+pymysql://root:password@localhost:3306/beauty_assistant"

    # Redis配置
    REDIS_URL: str = "redis://localhost:6379/0"

    # ChromaDB配置
    CHROMA_PERSIST_DIRECTORY: str = "./chroma_db"
    CHROMA_COLLECTION_NAME: str = "beauty_knowledge_base"

    # JWT配置（从环境变量读取）
    SECRET_KEY: str = "your-secret-key-here-change-in-production"
    ALGORITHM: str = "HS256"
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 30

    # 硅基流动API配置（从环境变量读取）
    SILICONFLOW_API_KEY: Optional[str] = None
    SILICONFLOW_API_URL: str = "https://api.siliconflow.cn/v1/embeddings"
    SILICONFLOW_EMBED_MODEL: str = "BAAI/bge-m3"

    # 硅基流动聊天API配置
    SILICONFLOW_CHAT_API_URL: str = "https://api.siliconflow.cn/v1/chat/completions"
    SILICONFLOW_CHAT_MODEL: str = "deepseek-ai/DeepSeek-V3.2"

    class Config:
        env_file = ".env"
        env_file_encoding = "utf-8"

# 创建配置实例
settings = Settings()
